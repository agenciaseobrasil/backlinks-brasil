generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OWNER
}

enum CompanyStatus {
  DRAFT
  PENDING
  APPROVED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum MediaType {
  IMAGE
}

enum AnalyticsType {
  VIEW
  CLICK
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           UserRole  @default(OWNER)
  emailVerified  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  companies      Company[]
  articles       Article[]
  analytics      AnalyticsEvent[]
}

model Company {
  id            String            @id @default(cuid())
  name          String
  description   String?
  website       String?
  contactEmail  String?
  phone         String?
  address       String?
  schedule      String?
  logoUrl       String?
  status        CompanyStatus     @default(PENDING)
  owner         User              @relation(fields: [ownerId], references: [id])
  ownerId       String
  categories    CompanyCategory[]
  articles      Article[]
  media         Media[]
  analytics     AnalyticsEvent[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Category {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  companies   CompanyCategory[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model CompanyCategory {
  company   Company @relation(fields: [companyId], references: [id])
  companyId String
  category  Category @relation(fields: [categoryId], references: [id])
  categoryId String

  @@id([companyId, categoryId])
}

model Article {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  content        String
  status         ArticleStatus   @default(DRAFT)
  publishedAt    DateTime?
  metaTitle      String?
  metaDescription String?
  noindex        Boolean         @default(false)
  company        Company         @relation(fields: [companyId], references: [id])
  companyId      String
  links          Link[]
  media          Media[]
  analytics      AnalyticsEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Link {
  id          String   @id @default(cuid())
  url         String
  anchorText  String?
  company     Company? @relation(fields: [companyId], references: [id])
  companyId   String?
  article     Article? @relation(fields: [articleId], references: [id])
  articleId   String?
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Media {
  id          String    @id @default(cuid())
  url         String
  alt         String?
  type        MediaType @default(IMAGE)
  provider    String?
  metadata    Json?
  company     Company?  @relation(fields: [companyId], references: [id])
  companyId   String?
  article     Article?  @relation(fields: [articleId], references: [id])
  articleId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AnalyticsEvent {
  id          String         @id @default(cuid())
  type        AnalyticsType
  company     Company?       @relation(fields: [companyId], references: [id])
  companyId   String?
  article     Article?       @relation(fields: [articleId], references: [id])
  articleId   String?
  link        Link?          @relation(fields: [linkId], references: [id])
  linkId      String?
  user        User?          @relation(fields: [userId], references: [id])
  userId      String?
  referrer    String?
  userAgent   String?
  ipHash      String?
  createdAt   DateTime       @default(now())
}
